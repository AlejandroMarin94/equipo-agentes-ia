# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública: la "anon" clásica o la nueva "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. Se salta RLS; nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Token de la suscripción de Claude (sale de `claude setup-token`). Obligatorio en Vercel;
# en local, sin él se usa la sesión de Claude Code del equipo. Nunca ANTHROPIC_API_KEY: no se usa.
CLAUDE_CODE_OAUTH_TOKEN=

# Modelos de cada agente (opcionales), separados por comas: el primero que responda.
# Sin definir o vacías = estos valores. Compruébalos con: npm run check-claude
# CLAUDE_MODELS_ORCHESTRATOR=claude-opus-5-5,claude-sonnet-5-5
# CLAUDE_MODELS_DEVELOP=claude-sonnet-5-5
# CLAUDE_MODELS_TESTING=claude-sonnet-5-5

# claude = agentes reales · mock = respuestas deterministas, sin gastar la suscripción (desarrollo y demo)
LLM_PROVIDER=claude

# Ejecuciones de todos los usuarios juntos en la última hora (protege la suscripción)
MAX_RUNS_PER_HOUR=3
# Ejecuciones por usuario cada 24 horas
MAX_RUNS_PER_DAY=10

# Opcional, solo con LLM_PROVIDER=mock: retardo simulado por llamada (ms)
# MOCK_DELAY_MS=1500
