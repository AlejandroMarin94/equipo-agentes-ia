# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública: la "anon" clásica o la nueva "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. Se salta RLS; nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey, plan gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# gemini = agentes reales · mock = respuestas deterministas sin clave (desarrollo y demo)
LLM_PROVIDER=gemini

# Ejecuciones por usuario cada 24 horas (protege la cuota gratuita)
MAX_RUNS_PER_DAY=15

# Opcional, solo con LLM_PROVIDER=mock: retardo simulado por llamada (ms)
# MOCK_DELAY_MS=1500
