# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública: la "anon" clásica o la nueva "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. Se salta RLS; nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Claves de IA (todas en plan gratuito, sin tarjeta). Basta con una: cada agente salta los modelos sin clave.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Mistral: https://console.mistral.ai → API Keys (plan Experiment)
MISTRAL_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadena de modelos de cada agente (opcionales): proveedor/modelo separados por comas; el primero que responda.
# Sin definir o vacías = estos valores. Comprueba cada eslabón con: npx tsx scripts/check-llm.ts
# LLM_CHAIN_ORCHESTRATOR=groq/openai/gpt-oss-120b?reasoning_effort=low,groq/qwen/qwen3.8-27b,mistral/mistral-small-2603,gemini/gemini-3.5-flash
# LLM_CHAIN_DEVELOP=mistral/mistral-large-4,mistral/mistral-small-2603,groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite
# LLM_CHAIN_TESTING=groq/openai/gpt-oss-120b,groq/qwen/qwen3.8-27b,groq/openai/gpt-oss-20b,mistral/mistral-small-2603,gemini/gemini-3.5-flash-lite
# (GEMINI_MODEL, GEMINI_MODEL_* y GEMINI_FALLBACK_MODELS ya no se usan.)

# real = agentes reales · mock = respuestas deterministas sin clave (desarrollo y demo)
LLM_PROVIDER=real

# Ejecuciones por usuario cada 24 horas (protege la cuota gratuita)
MAX_RUNS_PER_DAY=15
# Ejecuciones de todos los usuarios juntos en la última hora (las cuotas de las claves son para todos)
MAX_RUNS_PER_HOUR=4

# Opcional, solo con LLM_PROVIDER=mock: retardo simulado por llamada (ms)
# MOCK_DELAY_MS=1500
